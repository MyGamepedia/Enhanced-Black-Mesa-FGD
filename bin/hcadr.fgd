@SolidClass base(BaseTrain) 
	sphere(fademindist)
	sphere(fademaxdist)
	line(255 255 0, targetname, target)
= func_tracktrain: "A moving platform that the player can ride. It follows a path of path_track entities.\nNOTE: Build your train so that the front of the train is facing down the X axis. When it spawns it will automatically rotate to face the next path_track on the path."
	[
	spawnflags(flags)  =
		[
		1: "[1] No Pitch (X-rot)" : 0
		2: "[2] No User Control" : 0
		4: "[4] Forward Only" : 0
		8: "[8] Passable" : 0
		16: "[16] Always Fixed Orientation" : 0
		128: "[128] Rideable Train (HL1 Train)" : 0
		256: "[256] Use max speed for pitch shifting move sound" : 0
		512: "[512] Not blockable by players" : 0
		]
		
	// Inputs
	input SetEmergencyStop(void) : "Slows down the train until it fully stops movement. Normally used by prop_train_awesome when the player is off the train."
	input EnableControls(void) : "Allows player controls."
	input DisableControls(void) : "Prevents player controls. If a prop_train_awesome is paranted, prop_train_awesome will always use red light color. If a player was controlling the train, the player will stop control."
	input SetVelocityType(integer) : "Sets the way train toggles between speed modes. 0 - instant. 1 - smooth. 2 - instant, attempt to use backward movement will cause train to constantly switch between backward and low speed forward."	

	// Outputs
	output OnBackward(void) : "HCADR only. Fired when backward movement starts."
	output OnForward(void) : "HCADR only. Fired when forward movement starts."
	output OnStop(void) : "HCADR only. Fired when train stopped movement."
	]
	
