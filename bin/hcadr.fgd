@PointClass base(BaseEntityPoint, BmNewLightBaseMain, BmNewLightShadowMain, BmNewLightShadowFace, BmNewLightShadowBias, BmNewLightCookieMain, BmNewLightGodraysMode, BmGodraysNormal, BmGodraysFancy, BmNewLightShadowPasses) 
	studio("models/editor/angle_helper.mdl")
	iconsprite("editor/light_new.vmt")
	sphere(range)
	sphere(NearZ)
= newLight_Point: "It creates an invisible deferred light source that shines in all directions, includes godrays and lightcookies."
	[

	// Inputs
	input TurnOn(void) : "Turn the light on."
	input TurnOff(void) : "Turn the light off."
	input Toggle(void) : "Toggle the light's current state."
	input TurnOnGodRays(void) : "Turn the godrays on."
	input TurnOffGodRays(void) : "Turn the godrays off."
	input SetIntensityForLight(float) : "Change light's intensity value. Doesn't affect the godrays."
	input SetColorLight(color255) : "Change light's color value. Doesn't affect the godrays."
	input SetShadowRadius(void) : "Set Shadow Radius value."
	]

@PointClass base(BaseEntityPoint, BmNewLightReverseDir, BmNewLightsSettings, BmNewLightShadowFOV, BmNewLightShadowBias, BmNewLightCookieSpot, BmNewLightShadowPasses) 
	lightprop("models/editor/spot.mdl")
	iconsprite("editor/light_new.vmt")
	sphere(range)
	sphere(NearZ)
	frustum(phi,NearZ,Range,LightColor,-1)
= newLight_Spot: "It is a cone-shaped, invisible deferred light source, includes lightcookies with animations for them. The animations is based on row and column atlases or scroll mode."
	[

	// Inputs
	input TurnOn(void) : "Turn the light on."
	input TurnOff(void) : "Turn the light off."
	input Toggle(void) : "Toggle the light's current state."
	input SetIntensityForLight(float) : "Change light's color value."
	input SetColorLight(color255) : "Change light's intensity value."
	input InputFixRotBugDueToTram(void) : "This is an unused input. Doesn't seem to do anything. Perhaps it initially should enable the direction reversing."
	input SetShadowRadius(void) : "Set Shadow Radius value."
	]
	
